{% comment %}
  Hero Section — Natural Care / Beauty Brand (Swiper Slider)
  Slider: Swiper.js (CDN) — sirf loop + autoplay (koi navigation arrows, koi pagination dots nahi)
  Har slide ek block hai. Sab images par blank condition lagi hui hai.

  UPDATE: Ab desktop_banner_image aur hero_image (mobile) dono EK hi
  ".hero-section__banner" wrapper ke andar render hote hain. CSS classes
  (--desktop / --mobile) decide karti hain kaunsi image kis screen size par
  dikhegi. Content (heading/desc/button) ab mobile par bhi image ke upar
  overlay hota hai — bilkul desktop wale style ki tarah. Desktop CSS/behaviour
  bilkul same rakha gaya hai, sirf mobile (max-width:750px) query me changes hain.
{% endcomment %}

{%- comment -%} ── Swiper CDN ── {%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<section
  class="hero-section"
  id="shopify-section-{{ section.id }}"
  style="
    --hero-bg: {{ section.settings.bg_color }};
    --hero-pt-desktop: {{ section.settings.padding_top_desktop }}px;
    --hero-pb-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --hero-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --hero-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --hero-btn-bg: {{ section.settings.button_bg_color }};
    --hero-btn-color: {{ section.settings.button_text_color }};
    --hero-btn-hover-bg: {{ section.settings.button_hover_bg_color }};
    --hero-btn-hover-color: {{ section.settings.button_hover_text_color }};
    --hero-heading-color: {{ section.settings.heading_color }};
    --hero-desc-color: {{ section.settings.description_color }};
  "
  aria-label="{{ section.settings.section_aria_label | escape }}"
>
  <div class="page-widths">
    <div class="swiper hero-swiper hero-swiper--{{ section.id }}" data-hero-swiper-id="{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="hero-rel">
              <div class="hero-section__grid">
                {%- comment -%} ── LEFT COLUMN — Content (overlays image on both desktop & mobile) ── {%- endcomment -%}
                <div class="hero-section__content">
                  {%- comment -%} Rating Row {%- endcomment -%}
                  {%- if block.settings.show_rating -%}
                    <div
                      class="hero-section__rating"
                      aria-label="{{ block.settings.rating_aria_label | escape }}"
                    >
                      {%- if block.settings.rating_image != blank -%}
                        {%- assign rating_alt = block.settings.rating_image.alt | default: 'Customer rating' | escape -%}
                        {{
                          block.settings.rating_image
                          | image_url: width: 120
                          | image_tag:
                            loading: 'eager',
                            fetchpriority: 'low',
                            alt: rating_alt,
                            width: 120,
                            height: 20,
                            class: 'hero-section__rating-img'
                        }}
                      {%- endif -%}

                      {%- if block.settings.rating_richtext != blank -%}
                        <div class="hero-section__rating-text rte">
                          {{ block.settings.rating_richtext }}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- comment -%} Heading {%- endcomment -%}
                  {%- if block.settings.heading != blank -%}
                    <{{ block.settings.heading_tag }} class="hero-section__heading">
                      {{ block.settings.heading }}
                    </{{ block.settings.heading_tag }}>
                  {%- endif -%}

                  {%- comment -%} Description {%- endcomment -%}
                  {%- if block.settings.description != blank -%}
                    <p class="hero-section__description">
                      {{ block.settings.description }}
                    </p>
                  {%- endif -%}

                  {%- comment -%} CTA Button {%- endcomment -%}
                  {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
                    <a class="hero-section__btn"
                      href="{{ block.settings.button_url }}"
                      {% if block.settings.button_open_new_tab %}
                        target="_blank" rel="noopener noreferrer"
                      {% endif %}
                      aria-label="{{ block.settings.button_label | escape }}"
                    >
                      {{- block.settings.button_label | escape -}}
                    </a>
                  {%- endif -%}
                </div>
                {%- comment -%} ── END LEFT COLUMN ── {%- endcomment -%}
              </div>

              {%- comment -%} ── Banner Image Wrapper — Desktop image + Mobile image dono yahan ── {%- endcomment -%}
              {%- if block.settings.desktop_banner_image != blank or block.settings.hero_image != blank -%}
                <div class="hero-section__banner">
                  {%- comment -%} Desktop banner image — sirf desktop par dikhta hai {%- endcomment -%}
                  {%- if block.settings.desktop_banner_image != blank -%}
                    {%- assign banner_alt = block.settings.desktop_banner_image.alt
                      | default: block.settings.heading
                      | strip_html
                      | escape
                    -%}
                    {%- if forloop.first -%}
                      {{
                        block.settings.desktop_banner_image
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'eager',
                          fetchpriority: 'high',
                          alt: banner_alt,
                          widths: '1200,1500,1800,2000',
                          class: 'hero-section__banner-image hero-section__banner-image--desktop'
                      }}
                    {%- else -%}
                      {{
                        block.settings.desktop_banner_image
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'lazy',
                          fetchpriority: 'low',
                          alt: banner_alt,
                          widths: '1200,1500,1800,2000',
                          class: 'hero-section__banner-image hero-section__banner-image--desktop'
                      }}
                    {%- endif -%}
                  {%- endif -%}

                  {%- comment -%} Mobile hero image — sirf mobile par dikhta hai {%- endcomment -%}
                  {%- if block.settings.hero_image != blank -%}
                    {%- assign hero_alt = block.settings.hero_image.alt
                      | default: block.settings.heading
                      | strip_html
                      | escape
                    -%}
                    {%- if forloop.first -%}
                      {{
                        block.settings.hero_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'eager',
                          fetchpriority: 'high',
                          alt: hero_alt,
                          width:'100%',
                          height: 'auto',
                          class: 'hero-section__banner-image hero-section__banner-image--mobile',
                          sizes: '100vw',
                          widths: '400, 600, 750, 900'
                      }}
                    {%- else -%}
                      {{
                        block.settings.hero_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          fetchpriority: 'low',
                          alt: hero_alt,
                          width: '100%',
                          height: 'auto',
                          class: 'hero-section__banner-image hero-section__banner-image--mobile',
                          sizes: '100vw',
                          widths: '400, 600, 750, 900'
                      }}
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- comment -%} ── END Banner Image Wrapper ── {%- endcomment -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section shell ── */
  .hero-section {
    background-color: var(--hero-bg, #f9f5f0);
    padding-top: var(--hero-pt-mobile, 48px);
    padding-bottom: var(--hero-pb-mobile, 48px);
    overflow: hidden;
  }

  @media (min-width: 750px) {
    .hero-section {
      padding-top: var(--hero-pt-desktop, 80px);
      padding-bottom: var(--hero-pb-desktop, 80px);
    }
  }

  /* ── Swiper shell ── */
  .hero-swiper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .hero-swiper .swiper-slide {
    width: 100%;
    height: auto;
  }

  /* Swiper load hone se pehle sirf pehli slide dikhe (flash rokne ke liye) */
  .hero-swiper:not(.swiper-initialized) .swiper-wrapper {
    display: block;
  }

  .hero-swiper:not(.swiper-initialized) .swiper-slide + .swiper-slide {
    display: none;
  }

  /* ── Two-column grid (Desktop default: overlay on top of banner) ── */
  .hero-section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 750px) {
    .hero-section__grid {
      grid-template-columns: 1fr 1fr;
      gap: 0px;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      left: 9%;
      z-index: 2;
    }
  }

  /* ── Content ── */
  .hero-section__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    order: 2;
    max-width: 615px;
  }

  @media (min-width: 750px) {
    .hero-section__content {
      order: 1;
    }
  }

  /* ── Rating ── */
  .hero-section__rating {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }

  .hero-section__rating-img {
    display: block;
    width: auto;
    height: 24px;
    object-fit: contain;
  }

  .hero-section__rating-text {
    color: #101010;
    text-align: center;
    font-family: 'Plus Jakarta Sans';
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: 148%;
    text-transform: capitalize;
  }

  .hero-section__rating-text p {
    margin: 0;
  }

  /* ── Heading ── */
  .hero-section__heading {
    color: #000;
    {% comment %} font-family: var(--banner-font); {% endcomment %}
    font-family: Mona Sans !important;
    font-weight: 600;
    font-size: 60px;
    font-style: normal;
    line-height: 66px;
    letter-spacing: -0.86px;
    text-transform: capitalize;
  }

  /* ── Description ── */
  .hero-section__description {
    color: #000;
    font-family: 'Plus Jakarta Sans';
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
    padding: 0 0 30px;
    max-width: 566px;
  }

  /* ── CTA Button ── */
  .hero-section__btn {
    background: {{ section.settings.button_bg_color }} !important;
    color: var(--hero-btn-color, #000) !important;
    font-family: 'Plus Jakarta Sans';
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
    line-height: 148%;
    text-transform: capitalize;
    display: flex;
    width: 209.5px;
    padding: 18px 30px;
    justify-content: center;
    align-items: center;
    gap: 10.07px;
    border-radius: 41px;
    transition: background-color 0.25s ease, color 0.25s ease;
    white-space: nowrap;
  }

  .hero-section__btn:hover,
  .hero-section__btn:focus-visible {
    background-color: var(--hero-btn-hover-bg, #1a1a1a) !important;
    color: var(--hero-btn-hover-color, #fff) !important;
    outline-offset: 3px;
  }

  .hero-rel {
    position: relative;
  }

  /* ── Banner wrapper (holds desktop + mobile image, controls flow height) ── */
  .hero-section__banner {
    position: relative;
    width: 100%;
  }

  .hero-section__banner-image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Default (desktop-first): show desktop image, hide mobile image */
  .hero-section__banner-image--desktop {
    display: block;
  }

  .hero-section__banner-image--mobile {
    display: none;
  }

  /* ═══════════════════════════════════════════════
     MOBILE ONLY CHANGES — desktop bilkul untouched
     ═══════════════════════════════════════════════ */
  @media (max-width: 750px) {
    .hero-section__content {
      gap: 16px;
      order: 1;
      text-align: center;
    }

    .hero-section__grid {
      gap: 30px;
      align-items: center;
      justify-content: center;
      /* Content ko image ke upar overlay karne ke liye — desktop wale pattern jaisa */
      position: absolute;
      top: 22%;
      left: 0;
      transform: translateY(-50%);
      width: 100%;
      padding: 0 16px;
      z-index: 2;
    }

    .hero-section__rating-img {
      display: block;
      width: 100px;
      height: 15px;
      object-fit: contain;
    }

    .hero-section__rating {
      gap: 9px;
      justify-content: center;
    }

    .hero-section__rating-text {
      font-size: 14px;
      font-style: normal;
      font-weight: 500;
      line-height: 148%;
      text-transform: capitalize;
    }

    .hero-section__heading {
      font-size: 36px;
      font-style: normal;
      font-weight: 500;
      line-height: 42px;
      letter-spacing: -0.86px;
      text-transform: capitalize;
      max-width: 343px;
      margin: 0 auto;
    }

    .hero-section__description {
      font-size: 14px;
      font-style: normal;
      font-weight: 400;
      line-height: 22px;
      padding: 0 0 8px;
      max-width: 316px;
      text-align: center;
      margin: 0 auto;
    }

    .hero-section__btn {
      padding: 14.196px 23.66px;
      border-radius: 32px;
      font-size: 14px;
      font-style: normal;
      font-weight: 600;
      line-height: 148%;
      text-transform: capitalize;
      width: 100%;
    }

    /* Banner: mobile image dikhaye, desktop image chupaye */
    .hero-section__banner-image--desktop {
      display: none;
    }

    .hero-section__banner-image--mobile {
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
      max-height: 520px; 
       min-height: 520px; 
    }
  }
</style>

<script>
  (function () {
    var sectionId = {{ section.id | json }};

    function initHeroSwiper() {
      var el = document.querySelector('.hero-swiper--' + sectionId);
      if (!el) return;

      if (el.swiper) {
        el.swiper.destroy(true, true);
      }

      if (typeof Swiper === 'undefined') {
        setTimeout(initHeroSwiper, 100);
        return;
      }

      new Swiper(el, {
        loop: el.querySelectorAll('.swiper-slide').length > 1,
        speed: 1000,
        autoplay: {
          delay: 1500,
          disableOnInteraction: false
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initHeroSwiper);

    document.addEventListener('shopify:section:load', function (event) {
      if (event.target.querySelector('.hero-swiper--' + sectionId)) {
        initHeroSwiper();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Hero — Natural Care",
  "tag": "section",
  "class": "section-hero-natural",
  "limit": 1,
  "max_blocks": 10,
  "settings": [
    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top_desktop", "label": "Padding Top — Desktop (px)", "min": 0, "max": 200, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_bottom_desktop", "label": "Padding Bottom — Desktop (px)", "min": 0, "max": 200, "step": 4, "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding Top — Mobile (px)", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding Bottom — Mobile (px)", "min": 0, "max": 120, "step": 4, "default": 48 },
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "bg_color", "label": "Section Background Colour", "default": "#f9f5f0" },
    { "type": "header", "content": "Global Button Colours" },
    { "type": "color", "id": "button_bg_color", "label": "Button Background", "default": "#d4a84b" },
    { "type": "color", "id": "button_text_color", "label": "Button Text Colour", "default": "#1a1a1a" },
    { "type": "color", "id": "button_hover_bg_color", "label": "Button Hover Background", "default": "#1a1a1a" },
    { "type": "color", "id": "button_hover_text_color", "label": "Button Hover Text Colour", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading Colour", "default": "#1a1a1a" },
    { "type": "color", "id": "description_color", "label": "Description Colour", "default": "#555555" },
    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "section_aria_label", "label": "Section Aria Label", "default": "Hero banner — Natural Care, Rooted In Taiwan" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Rating" },
        { "type": "checkbox", "id": "show_rating", "label": "Show Rating Row", "default": true },
        { "type": "image_picker", "id": "rating_image", "label": "Rating Stars Image" },
        { "type": "richtext", "id": "rating_richtext", "label": "Rating Label (Rich Text)", "default": "<p>10,500+ 5-Star Reviews</p>" },
        { "type": "text", "id": "rating_aria_label", "label": "Rating Row Aria Label", "default": "Customer rating: 10,500+ five-star reviews" },
        { "type": "header", "content": "Heading" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Natural Care, Rooted In Taiwan" },
        { "type": "select", "id": "heading_tag", "label": "Heading HTML Tag", "options": [ { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" } ], "default": "h1" },
        { "type": "header", "content": "Description" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Natural soaps, body care, and gift sets made with Taiwanese botanical inspiration and small-batch care in New York." },
        { "type": "header", "content": "Button" },
        { "type": "text", "id": "button_label", "label": "Button Label", "default": "Shop Now" },
        { "type": "url", "id": "button_url", "label": "Button URL", "default": "/collections/all" },
        { "type": "checkbox", "id": "button_open_new_tab", "label": "Open in new tab", "default": false },
        { "type": "header", "content": "Images" },
        { "type": "image_picker", "id": "desktop_banner_image", "label": "Desktop Banner Image" },
        { "type": "image_picker", "id": "hero_image", "label": "Hero Image Mobile" },
      
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero — Natural Care",
      "settings": {
        "padding_top_desktop": 80,
        "padding_bottom_desktop": 80,
        "padding_top_mobile": 48,
        "padding_bottom_mobile": 48,
        "bg_color": "#f9f5f0",
        "button_bg_color": "#d4a84b",
        "button_text_color": "#1a1a1a",
        "button_hover_bg_color": "#1a1a1a",
        "button_hover_text_color": "#ffffff",
        "heading_color": "#1a1a1a",
        "description_color": "#555555",
        "section_aria_label": "Hero banner — Natural Care, Rooted In Taiwan"
      },
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "show_rating": true,
            "rating_richtext": "<p>10,500+ 5-Star Reviews</p>",
            "rating_aria_label": "Customer rating: 10,500+ five-star reviews",
            "heading": "Natural Care, Rooted In Taiwan",
            "heading_tag": "h1",
            "description": "Natural soaps, body care, and gift sets made with Taiwanese botanical inspiration and small-batch care in New York.",
            "button_label": "Shop Now",
            "button_url": "/collections/all",
            "button_open_new_tab": false,
           
          }
        },
        {
          "type": "slide",
          "settings": {
            "show_rating": true,
            "rating_richtext": "<p>10,500+ 5-Star Reviews</p>",
            "rating_aria_label": "Customer rating: 10,500+ five-star reviews",
            "heading": "Small Batch, Big Care",
            "heading_tag": "h2",
            "description": "Every bar is poured, cured, and cut by hand in small batches — no fillers, no shortcuts.",
            "button_label": "Shop Now",
            "button_url": "/collections/all",
            "button_open_new_tab": false,
          
          }
        }
      ]
    }
  ]
}
{% endschema %}
